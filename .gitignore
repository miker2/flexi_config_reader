__pycache__
.ipynb_checkpoints

sandbox
# Anchored and directory-only on purpose. A bare `build` also matches every
# Bazel `BUILD` file on case-insensitive filesystems (macOS default), which
# silently hides new packages from git.
/build/
build-debug
# CLion
cmake-build*

# Bazel
/bazel-*
# Bazel 8 and 9 resolve some module extensions differently, so a shared
# lockfile churns depending on which one you run. Versions are pinned in
# MODULE.bazel instead.
MODULE.bazel.lock
