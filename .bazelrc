# Bzlmod is the default in Bazel 7+; state it explicitly so a Bazel 8 or 9
# invocation behaves identically regardless of any user-level bazelrc.
common --enable_bzlmod

# Let the `build:linux` / `build:macos` / `build:windows` sections below be
# selected automatically based on the host platform.
build --enable_platform_specific_config

# C++20 is required by the library and by its public headers.
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

build:linux --cxxopt=-Wall --cxxopt=-Wextra
build:macos --cxxopt=-Wall --cxxopt=-Wextra
# Bazel still defaults the deployment target to an ancient macOS release, which
# makes libc++ reject C++17 aligned allocation (used by range-v3). 11.0 is the
# oldest release Apple silicon supports.
build:macos --macos_minimum_os=11.0
build:macos --host_macos_minimum_os=11.0
# Apple's crosstool injects `-DDEBUG=1` for non-opt builds, which collides with
# the `flexi_cfg::logger::Severity::DEBUG` enumerator. Nothing here uses the
# macro, so drop it.
build:macos --cxxopt=-UDEBUG

test --test_output=errors

# AddressSanitizer + UndefinedBehaviorSanitizer:  bazel test --config=sanitize //...
# Mirrors the CFG_SANITIZE option in CMakeLists.txt. The compiler flags below
# must stay identical to that list; scripts/check_sanitizer_flags.py enforces
# it in CI.
build:sanitize --copt=-fsanitize=address,undefined
build:sanitize --copt=-fno-omit-frame-pointer
build:sanitize --copt=-fno-sanitize-recover=undefined
build:sanitize --linkopt=-fsanitize=address,undefined
build:sanitize --strip=never
# Leak detection is on by default where LSan is supported (Linux), and left
# unset here so this config also runs on macOS.
# Targets tagged no_sanitize (the python bindings test) are skipped.
test:sanitize --test_tag_filters=-no_sanitize
test:sanitize --test_env=ASAN_OPTIONS=strict_string_checks=1:abort_on_error=1
test:sanitize --test_env=UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1
